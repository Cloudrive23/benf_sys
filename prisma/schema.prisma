  attachment_sections attachment_sections? @relation(fields: [section_id], references: [id], onUpdate: NoAction)

  @@index([beneficiary_id], map: "idx_entity_attachments_beneficiary")
  @@index([is_current, is_active], map: "idx_entity_attachments_current")
  @@index([entity_type, entity_id], map: "idx_entity_attachments_entity")
  @@index([file_number], map: "idx_entity_attachments_file_number")
  @@index([report_year, report_type], map: "idx_entity_attachments_report")
  @@index([section_id], map: "idx_entity_attachments_section")
  @@index([attachment_type_id], map: "idx_entity_attachments_type")
  @@index([uploaded_at], map: "idx_entity_attachments_uploaded_at")
}
