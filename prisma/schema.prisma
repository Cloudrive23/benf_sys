/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model attachment_types {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                        String                        @unique @db.VarChar(100)
  name_ar                     String                        @db.VarChar(255)
  name_en                     String?                       @db.VarChar(255)
  category                    String                        @db.VarChar(50)
  is_required                 Boolean?                      @default(false)
  allowed_extensions          String?
  max_file_size_mb            Int?
  is_active                   Boolean?                      @default(true)
  created_at                  DateTime?                     @default(now()) @db.Timestamp(6)
  updated_at                  DateTime?                     @default(now()) @db.Timestamp(6)
  entity_type                 String?                       @db.VarChar(100)
  section_id                  String?                       @db.Uuid
  path_segment                String?                       @db.VarChar(255)
  allowed_mime_types          String?
  min_width                   Int?
  max_width                   Int?
  min_height                  Int?
  max_height                  Int?
  is_image_required           Boolean                       @default(false)
  allow_multiple              Boolean                       @default(false)
  naming_strategy             String                        @default("file_number") @db.VarChar(100)
  path_template               String?
  sort_order                  Int                           @default(0)
  notes                       String?
  attachment_sections         attachment_sections?          @relation(fields: [section_id], references: [id], onUpdate: NoAction)
  beneficiary_attachments     beneficiary_attachments[]
  entity_attachments          entity_attachments[]
  periodic_report_attachments periodic_report_attachments[]

  @@index([category], map: "idx_attachment_types_category")
  @@index([entity_type], map: "idx_attachment_types_entity_type")
  @@index([section_id], map: "idx_attachment_types_section_id")
  @@index([sort_order], map: "idx_attachment_types_sort_order")
}

